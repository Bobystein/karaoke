# Karaoke server. Install with:
#   sudo cp deploy/karaoke.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now karaoke
[Unit]
Description=coatl karaoke (FastAPI, port 8004)
After=network-online.target
Wants=network-online.target
# The video library lives on this disk (KARAOKE_MEDIA_DIR). If it isn't
# mounted, don't start: downloads would silently fill up the system disk.
RequiresMountsFor=/mnt/media

[Service]
Type=simple
User=rober
Group=rober
WorkingDirectory=/home/rober/karaoke
# Admin password and WiFi details for the QR code. Kept out of git.
EnvironmentFile=/home/rober/karaoke/.env
# So `pactl` (volume control) can find rober's session audio.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/rober/karaoke/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8004
Restart=on-failure
RestartSec=3
# A half-done download can take a while to let go; on restart it goes back to the queue.
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
