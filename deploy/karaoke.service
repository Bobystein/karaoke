# Servidor del karaoke. Instalar con:
#   sudo cp deploy/karaoke.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now karaoke
[Unit]
Description=Karaoke de coatl (FastAPI, puerto 8004)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rober
Group=rober
WorkingDirectory=/home/rober/karaoke
# Contrasena de admin y datos del WiFi para el QR. Fuera de git.
EnvironmentFile=/home/rober/karaoke/.env
# Para que `pactl` (control de volumen) encuentre el audio de la sesion de rober.
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/rober/karaoke/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8004
Restart=on-failure
RestartSec=3
# Una descarga a medias puede tardar en soltar; al reiniciar vuelve a la cola.
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
