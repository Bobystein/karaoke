# Copiar a .env (que esta en .gitignore) y llenar. Si un valor trae espacios
# o caracteres raros, ponlo entre comillas simples.

# Contrasena del modo admin. Vacia = modo admin deshabilitado.
KARAOKE_ADMIN_PASSWORD=

# WiFi de la casa, para el QR de la pantalla de espera.
KARAOKE_WIFI_SSID=
KARAOKE_WIFI_PASSWORD=
