# Copy to .env (which is in .gitignore) and fill in. If a value has spaces
# or unusual characters, wrap it in single quotes.

# Admin mode password. Empty = admin mode disabled.
KARAOKE_ADMIN_PASSWORD=
# Optional second admin password. Either one works. Empty = only the first.
KARAOKE_ADMIN_PASSWORD_2=

# Folder where the videos are downloaded and played from. Empty = media/
# inside the project. It should live on a disk with plenty of free space.
KARAOKE_MEDIA_DIR=

# Size limit of that folder, in GB (1 GB = 1000^3 bytes). Past it, the videos
# requested or played least recently are deleted. Empty = 150. 0 = no limit.
KARAOKE_MEDIA_MAX_GB=

# Minimum seconds between downloads when nobody is waiting for them (a song is
# playing and at least 2 more are ready). Empty = 90. Downloads go right away
# when the screen is idle or the cushion runs low.
KARAOKE_DOWNLOAD_INTERVAL_S=

# Home WiFi, for the QR code on the waiting screen.
KARAOKE_WIFI_SSID=
KARAOKE_WIFI_PASSWORD=

# Fallback routes for downloads, tried in this order when YouTube turns down
# the direct one ("confirm you're not a bot", or an error we don't recognize).
#
# 1. YouTube cookies (Netscape cookies.txt format). Only used if the file
#    exists. yt-dlp writes refreshed cookies back, so the file must be
#    writable by the service user. Use a throwaway Google account, not your
#    personal one.
KARAOKE_COOKIES_FILE=
# 2. An HTTP proxy that goes out through another IP. On coatl, the VPN's:
#    http://127.0.0.1:8888 (gluetun, in /srv/docker/qbittorrent).
KARAOKE_PROXY_URL=

# Health check of those routes (app/check.py, run by deploy/karaoke-check.timer).
# The Push URL of a monitor in uptime-kuma, which sends the alerts; the part
# after "?" doesn't matter. Empty = the check runs but tells nobody.
KARAOKE_KUMA_PUSH_URL=
# The video it asks YouTube for. Empty = one that has been up for years.
KARAOKE_CHECK_VIDEO_ID=
