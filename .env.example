# Copy to .env (which is in .gitignore) and fill in. If a value has spaces
# or unusual characters, wrap it in single quotes.

# Admin mode password. Empty = admin mode disabled.
KARAOKE_ADMIN_PASSWORD=
# Optional second admin password. Either one works. Empty = only the first.
KARAOKE_ADMIN_PASSWORD_2=

# Folder where the videos are downloaded and played from. Empty = media/
# inside the project. It should live on a disk with plenty of free space.
KARAOKE_MEDIA_DIR=

# Size limit of that folder, in GB (1 GB = 1000^3 bytes). Past it, the videos
# requested or played least recently are deleted. Empty = 150. 0 = no limit.
KARAOKE_MEDIA_MAX_GB=

# Home WiFi, for the QR code on the waiting screen.
KARAOKE_WIFI_SSID=
KARAOKE_WIFI_PASSWORD=

# Optional: YouTube cookies (Netscape cookies.txt format) for when YouTube
# asks to "confirm you're not a bot". Only used if the file exists. yt-dlp
# writes refreshed cookies back, so the file must be writable by the service
# user. Use a throwaway Google account, not your personal one.
KARAOKE_COOKIES_FILE=
